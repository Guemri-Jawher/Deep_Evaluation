# --- LLM provider: LLM_PROVIDER = openrouter | nvidia (picks the block used by every chat model) ---
LLM_PROVIDER=openrouter

# OpenRouter (free models work)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Agent and judge use DIFFERENT model families on purpose (avoids judge self-preference bias).
AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SUBAGENT_MODEL=google/gemma-4-26b-a4b-it:free
JUDGE_MODEL=google/gemma-4-31b-it:free
# Tried in order when a model is rate-limited (429). Use other providers than the primary: the two
# Gemma models share one upstream pool. Empty disables fallback.
FALLBACK_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free

# NVIDIA API catalog (OpenAI-compatible; key starts with nvapi-). Used when LLM_PROVIDER=nvidia.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_SUBAGENT_MODEL=openai/gpt-oss-20b
NVIDIA_JUDGE_MODEL=openai/gpt-oss-20b

# --- Embeddings (local, no key) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Langfuse (https://cloud.langfuse.com) --- 
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Label of prompts fetched at runtime ("production" in prod, "staging" for experiments)
LANGFUSE_PROMPT_LABEL=production

# --- Runtime budgets (enforced in code, not in the prompt) ---
MAX_STEPS=25
MAX_TOOL_OUTPUT_CHARS=6000
